# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Khoá API thật nằm ở database/secrets.json do backend quản lý — các biến dưới đây
# chỉ dành cho lúc phát triển và cho script.

# --- HTTP server nội bộ ---
# Chỉ nghe 127.0.0.1. Bận cổng thì backend tự lấy cổng trống kế tiếp.
LIVE_PORT=47830

# --- Nguồn sự kiện TikTok ---
# webview = đọc từ webview trong app (mặc định, bản desktop)
# bridge  = nối tới máy chủ cầu nối ngoài
# mau     = dữ liệu giả lập, dùng khi phát triển
LIVE_SOURCE=mau
LIVE_CHANNEL=
BRIDGE_URL=ws://127.0.0.1:8787/ws/live

# --- Cơ sở dữ liệu ---
# Một file dùng chung cho cả dev và production. Đổi đường dẫn nếu muốn tách.
DATABASE_URL=sqlite://database/live.sqlite

# --- Giọng đọc ---
# Để trống thì rơi về giọng của trình duyệt.
TTS_PROVIDER=
TTS_BASE_URL=http://localhost:20128/v1
TTS_API_KEY=

# --- AI vận hành ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Ghi log ---
# error | warn | info | debug
LOG_LEVEL=info
