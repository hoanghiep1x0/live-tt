{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "manager",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@live/manager"
      ],
      "port": 5180
    },
    {
      "name": "ke-chuyen",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@live/design-ke-chuyen",
        "--",
        "--port",
        "5185",
        "--strictPort"
      ],
      "port": 5185,
      "autoPort": false
    },
    {
      "name": "tu-tien-son-ha",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@live/design-tu-tien-son-ha",
        "--",
        "--port",
        "5186",
        "--strictPort"
      ],
      "port": 5186,
      "autoPort": false
    },
    {
      "name": "xem-3d",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8771",
        "--directory",
        ".tmp/xem-3d"
      ],
      "port": 8771,
      "autoPort": false
    },
    {
      "name": "web-son-ha",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8772",
        "--directory",
        "web/son-ha-tien-lo"
      ],
      "port": 8772,
      "autoPort": false
    },
    {
      "name": "xuong-son-ha",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8773",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8773,
      "autoPort": false
    },
    {
      "name": "nhan-file",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "web/son-ha-tien-lo/cong-cu/nhan-file.py"
      ],
      "port": 8791,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "backend/Cargo.toml"
      ],
      "port": 47830,
      "autoPort": false
    }
  ]
}
